{
    "name": "2lenet/config-bundle",
    "type": "symfony-bundle",
    "description": "Config Bundle",
    "homepage": "https://www.2le.net",
    "license": "MIT",
    "authors": [
        {
            "name": "2LE Team",
            "homepage": "https://www.2le.net/",
            "email": "support@2le.net"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Lle\\ConfigBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "2lenet/crudit-bundle": "^1.12",
        "doctrine/doctrine-bundle": "^2.0 || ^3.0",
        "doctrine/orm": "^2.6,>=2.6.3 || ^3.0",
        "doctrine/persistence": "^2.0 || ^3.0 || ^4.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "twig/twig": "^3.4 || ^4.0"
    },
    "require-dev": {
        "ergebnis/phpstan-rules": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.0",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
